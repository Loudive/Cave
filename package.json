{
  "name": "cave-devourer",
  "version": "0.1.0",
  "description": "Cave Devourer — 2D-платформер-роуглайк про монстра в сети тёмных пещер. Phaser 3 + TypeScript + Vite.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets": "node scripts/generate-assets.mjs",
    "build": "npm run assets && tsc --noEmit && vite build",
    "build:local": "npm run assets && vite build --base=/game/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "cave:audit": "node scripts/cave-style-audit.mjs",
    "smoke:cave": "node scripts/smoke-cave.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^7.1.0"
  }
}